source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.4"
# Use postgresql as the database for Active Record (production + default dev/test)
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# forge-ci config compiler (component 1) — consumed for pipeline intake.
# Path defaults to the repo root (monorepo layout); override with
# FORGE_CI_GEM_PATH when building from a different context (e.g. Docker).
gem "forge-ci", path: ENV.fetch("FORGE_CI_GEM_PATH", ".."), require: "forge_ci"

# GitHub App auth: RS256 JWTs for installation-token exchange (component 3)
gem "jwt"

# S3-compatible object storage for ActiveStorage (logs, artifacts, caches).
# Only loaded when ACTIVE_STORAGE_SERVICE=amazon; local disk is the default.
gem "aws-sdk-s3", require: false
# Scales runner Auto Scaling Groups up when jobs queue (RunnerAutoscaler).
gem "aws-sdk-autoscaling", require: false
# Mints ECR authorization tokens for the registry-backed Docker layer cache
# (BuildCacheConfig).
gem "aws-sdk-ecr", require: false

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Use the database-backed adapters for Rails.cache and Active Job
gem "solid_cache"
gem "solid_queue"

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Deploy this application anywhere as a Docker container [https://kamal-deploy.org]
gem "kamal", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

group :development, :test do
  # SQLite fallback for local dev/test on machines without a Postgres server.
  # Production and the documented setup use Postgres (see config/database.yml).
  gem "sqlite3", "~> 2.0"

  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Audits gems for known security defects (use config/bundler-audit.yml to ignore issues)
  gem "bundler-audit", require: false
end

group :development do
  # Use console on exceptions pages [https://github.com/rails/web-console]
  gem "web-console"
end

<div class="auth">
  <a class="brand" href="/"><%= render "shared/logo" %>ForgeCI</a>
  <div class="card">
    <div class="card-body">
      <h1>Sign in</h1>
      <p class="lead">to the ForgeCI control plane</p>
      <%= render "shared/flash" %>
      <%= form_with url: login_path, method: :post do %>
        <div class="field">
          <label for="username">Username</label>
          <%= text_field_tag :username, params[:username], id: "username", autocomplete: "username", autofocus: true, required: true, autocapitalize: "none", spellcheck: false %>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <%= password_field_tag :password, nil, id: "password", autocomplete: "current-password", required: true %>
        </div>
        <button type="submit" class="btn-primary">Sign in</button>
      <% end %>
      <% if @no_users %>
        <p class="hint">No users exist yet. Set <code>FORGE_CI_UI_USER</code> and <code>FORGE_CI_UI_PASSWORD</code> and reload to create the first admin, or run <code>bin/rails forge_ci:create_user</code>.</p>
      <% end %>
    </div>
  </div>
  <p class="back"><a href="/">&larr; Back to the ForgeCI site</a></p>
</div>

<% if @user.errors.any? %><p class="flash-alert" role="alert"><%= @user.errors.full_messages.to_sentence %></p><% end %>
<%= form_with url: url, method: method, class: "stack" do %>
  <% if @user.new_record? %>
    <label for="username">Username</label>
    <%= text_field_tag :username, @user.username, id: "username", required: true, autocapitalize: "none", autocomplete: "off" %>
  <% else %>
    <p class="meta">Username: <span class="mono"><%= @user.username %></span></p>
  <% end %>
  <label for="role">Role</label>
  <%= select_tag :role, options_for_select(User.roles.keys, @user.role), id: "role" %>
  <label for="password"><%= @user.new_record? ? "Password" : "New password (leave blank to keep)" %> (min <%= User::MIN_PASSWORD_LENGTH %> characters)</label>
  <%= password_field_tag :password, nil, id: "password", autocomplete: "new-password", required: @user.new_record? %>
  <label for="password_confirmation">Confirm password</label>
  <%= password_field_tag :password_confirmation, nil, id: "password_confirmation", autocomplete: "new-password", required: @user.new_record? %>
  <button type="submit"><%= @user.new_record? ? "Create user" : "Save" %></button>
<% end %>
<p><%= link_to "← users", users_path %></p>

<% content_for(:title, "Users — ForgeCI") %>
<% content_for(:crumb, "Users") %>

<div class="page-header">
  <div>
    <h1 class="page-heading">Users</h1>
    <p>Admins manage users. Members can view and cancel pipelines.</p>
  </div>
  <div class="page-actions"><%= link_to new_user_path, class: "button-primary" do %><%= icon "plus" %>New user<% end %></div>
</div>
<%= render "shared/flash" %>

<section class="card" aria-label="Users">
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>User</th><th>Role</th><th>Last sign-in</th><th>Status</th><th class="num">Actions</th></tr></thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td>
              <span style="display: inline-flex; align-items: center; gap: 10px">
                <span class="user-avatar" style="width: 24px; height: 24px; font-size: 11px" aria-hidden="true"><%= user.username.first %></span>
                <span class="mono"><%= user.username %></span><% if user == current_user %><span class="chip">you</span><% end %>
              </span>
            </td>
            <td><%= user.role.capitalize %></td>
            <td class="text-muted"><%= user.last_login_at ? time_ago_tag(user.last_login_at) : "Never" %></td>
            <td>
              <% if user.locked? %>
                <span class="status-badge"><span class="status-dot" data-state="failed"></span>Locked until <%= user.locked_until.strftime("%H:%M") %></span>
              <% else %>
                <span class="status-badge"><span class="status-dot" data-state="success"></span>Active</span>
              <% end %>
            </td>
            <td class="num nowrap">
              <%= link_to "Edit", edit_user_path(user), class: "button-secondary button-sm" %>
              <% unless user == current_user %>
                <%= button_to "Delete", user_path(user), method: :delete, class: "button-danger button-sm",
                              form: { class: "inline", onsubmit: "return confirm('Delete #{j user.username}?')" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

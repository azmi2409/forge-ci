<% content_for(:title, "Account — ForgeCI") %>
<h1>Account</h1>
<p class="meta">Signed in as <span class="mono"><%= current_user.username %></span> (<%= current_user.role %>)</p>
<%= render "shared/flash" %>

<h2>Change password</h2>
<%= form_with url: account_path, method: :patch, class: "stack" do %>
  <label for="current_password">Current password</label>
  <%= password_field_tag :current_password, nil, id: "current_password", autocomplete: "current-password", required: true %>
  <label for="password">New password (min <%= User::MIN_PASSWORD_LENGTH %> characters)</label>
  <%= password_field_tag :password, nil, id: "password", autocomplete: "new-password", required: true %>
  <label for="password_confirmation">Confirm new password</label>
  <%= password_field_tag :password_confirmation, nil, id: "password_confirmation", autocomplete: "new-password", required: true %>
  <button type="submit">Change password</button>
<% end %>

<h2>Sessions</h2>
<p class="meta">Sign out every other browser/device signed in as you.</p>
<%= button_to "Sign out everywhere else", sign_out_everywhere_account_path, method: :post %>

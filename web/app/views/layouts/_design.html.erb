<%# Shared design system for every layout, following the Kilat.host conventions
    (KilatHost/web app/assets/tailwind/application.css): monochrome ink on canvas,
    1px hairlines for structure, colour only for state, Geist + Geist Mono.
    Dark mode is [data-theme="dark"] on <html>, set by the script below from the
    viewer's choice (light, dark or system). %>
<script>
  (function() {
    var mode = "system";
    try { mode = localStorage.getItem("forge-ci-theme") || "system"; } catch (_) {}
    var dark = mode === "dark" || (mode === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.dataset.theme = dark ? "dark" : "light";
    document.documentElement.dataset.themeMode = mode;
  })();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400..600&display=swap">
<style>
  :root {
    color-scheme: light;
    --canvas: #fafafa; --surface: #fff; --ink: #0a0a0a; --muted: #666; --subtle: #8f8f8f;
    --line: #ebebeb; --line-strong: #d4d4d4; --accent: #0a0a0a; --accent-soft: #f2f2f2;
    --danger: #d93036; --warn: #8a5a00; --ok: #2f8a3e;
    --status-ok: #45a557; --status-pending: #f5a623; --status-error: #e5484d;
    --shadow-menu: 0 1px 1px rgb(0 0 0 / 2%), 0 8px 16px -4px rgb(0 0 0 / 8%), 0 24px 32px -8px rgb(0 0 0 / 6%);
    --shadow-focus: 0 0 0 3px rgb(10 10 10 / 10%);
    --ease-out: cubic-bezier(.16, 1, .3, 1);
    --font-sans: "Geist", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --canvas: #000; --surface: #0a0a0a; --ink: #ededed; --muted: #a1a1a1; --subtle: #707070;
    --line: #1f1f1f; --line-strong: #333; --accent: #ededed; --accent-soft: #1a1a1a;
    --danger: #ff6166; --warn: #f0b849; --ok: #62c073;
    --shadow-menu: 0 0 0 1px #1f1f1f, 0 24px 48px -12px rgb(0 0 0 / 80%);
    --shadow-focus: 0 0 0 3px rgb(237 237 237 / 10%);
  }

  /* ---- base ---- */
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; text-rendering: optimizeLegibility; -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--canvas); color: var(--ink); font: 14px/20px var(--font-sans); font-feature-settings: "ss01", "cv11"; }
  ::selection { background: var(--ink); color: var(--canvas); }
  a { color: inherit; text-decoration: none; }
  button, summary, input[type="submit"] { cursor: pointer; }
  button, a, input, summary { -webkit-tap-highlight-color: transparent; }
  :focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 4px; }
  code, kbd, samp, pre { font-family: var(--font-mono); }
  input[type="radio"], input[type="checkbox"] { accent-color: var(--ink); }
  h1, h2, h3, p { margin: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .text-muted { color: var(--muted); }
  .text-subtle { color: var(--subtle); }
  .mono { font-family: var(--font-mono); font-size: 13px; }
  .tabular { font-variant-numeric: tabular-nums; }
  .truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nowrap { white-space: nowrap; }
  .icon { width: 20px; height: 20px; flex-shrink: 0; }
  .text-link { font-weight: 500; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; transition: text-decoration-color .15s var(--ease-out); }
  .text-link:hover { text-decoration-color: var(--ink); }
  .stack > * + * { margin-top: 24px; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }

  /* ---- brand ---- */
  .brand { display: inline-flex; align-items: center; flex-shrink: 0; white-space: nowrap; font-size: 17px; font-weight: 600; letter-spacing: -.03em; }
  .brand-logo-shell { display: flex; width: 32px; height: 32px; flex-shrink: 0; align-items: center; justify-content: center; margin-right: 8px; border-radius: 8px; background: var(--ink); color: var(--canvas); }
  .brand-logo { width: 24px; height: 24px; }

  /* ---- type ---- */
  .eyebrow { margin-bottom: 8px; font: 12px/1.5 var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .page-heading { font-size: 28px; font-weight: 600; line-height: 1.25; letter-spacing: -.035em; text-wrap: balance; }
  @media (min-width: 640px) { .page-heading { font-size: 32px; } }
  .page-header { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 32px; }
  .page-header > div { min-width: 0; }
  .page-header p:not(.eyebrow) { margin-top: 6px; font-size: 14px; color: var(--muted); }
  .page-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; margin-top: 10px; font-size: 13px; color: var(--muted); }
  .page-meta > span { display: inline-flex; align-items: center; gap: 6px; }
  .page-meta .icon { width: 16px; height: 16px; }
  .page-actions { display: flex; flex-wrap: wrap; gap: 8px; }

  /* ---- buttons ---- */
  .button-primary, .button-secondary, .button-ghost, .button-danger {
    display: inline-flex; height: 40px; align-items: center; justify-content: center; gap: 8px; white-space: nowrap;
    border-radius: 6px; border: 1px solid transparent; padding: 0 16px; font: 500 14px/20px var(--font-sans);
    transition: opacity .15s, transform .15s, background-color .15s, border-color .15s, color .15s;
    transition-timing-function: var(--ease-out);
  }
  .button-primary { background: var(--ink); color: var(--canvas); }
  .button-primary:hover { opacity: .86; }
  .button-primary:active { transform: scale(.98); }
  .button-secondary { border-color: var(--line); background: var(--surface); color: var(--ink); }
  .button-secondary:hover { border-color: var(--line-strong); background: var(--accent-soft); }
  .button-ghost { padding: 0 12px; background: transparent; color: var(--muted); }
  .button-ghost:hover { background: var(--accent-soft); color: var(--ink); }
  .button-danger { border-color: color-mix(in srgb, var(--danger) 35%, transparent); background: var(--surface); color: var(--danger); }
  .button-danger:hover { border-color: color-mix(in srgb, var(--danger) 60%, transparent); background: color-mix(in srgb, var(--danger) 5%, var(--surface)); }
  .button-sm { height: 32px; padding: 0 12px; font-size: 13px; gap: 6px; }
  .button-primary .icon, .button-secondary .icon, .button-ghost .icon, .button-danger .icon { width: 16px; height: 16px; }
  .button-block { width: 100%; }
  form.button_to, form.inline { display: inline; margin: 0; }
  .icon-button { display: flex; width: 32px; height: 32px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 9999px; border: 1px solid var(--line); background: var(--surface); color: var(--muted); transition: border-color .15s, color .15s; }
  .icon-button:hover { border-color: var(--line-strong); color: var(--ink); }
  .icon-button .icon { width: 16px; height: 16px; }

  /* ---- cards & panels ---- */
  .card { min-width: 0; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); }
  a.card { display: block; transition: border-color .15s var(--ease-out); }
  a.card:hover { border-color: var(--line-strong); }
  .card-header { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12px 16px; padding: 20px 20px 0; }
  .card-header:last-child { padding-bottom: 20px; }
  .card-header > div { min-width: 0; }
  .card-title { display: flex; align-items: center; gap: 8px; font-size: 16px; line-height: 24px; font-weight: 600; letter-spacing: -.015em; }
  .card-title .icon { width: 16px; height: 16px; color: var(--muted); }
  .card-desc { margin-top: 4px; max-width: 42rem; font-size: 14px; line-height: 24px; color: var(--muted); }
  .card-body { min-width: 0; padding: 20px; }
  .card-header + .card-body { padding-top: 16px; }
  .card-body + .card-body { border-top: 1px solid var(--line); }
  .card-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px solid var(--line); border-radius: 0 0 12px 12px; background: var(--canvas); padding: 12px 20px; font-size: 13px; color: var(--muted); }
  .card-header + .table-wrap { margin-top: 16px; border-top: 1px solid var(--line); }
  @media (min-width: 640px) {
    .card-header { padding: 24px 24px 0; } .card-header:last-child { padding-bottom: 24px; }
    .card-body { padding: 20px 24px; } .card-footer { padding: 12px 24px; }
  }

  /* ---- status ---- */
  .status-badge { display: inline-flex; height: 24px; align-items: center; gap: 6px; white-space: nowrap; border-radius: 9999px; border: 1px solid var(--line); background: var(--surface); padding: 0 10px; font-size: 12px; font-weight: 500; color: var(--ink); }
  .status-dot { display: inline-block; width: 7px; height: 7px; flex-shrink: 0; border-radius: 9999px; background-color: var(--subtle); }
  .status-dot[data-state="success"] { background-color: var(--status-ok); box-shadow: 0 0 0 3px rgb(69 165 87 / 18%); }
  .status-dot[data-state="running"], .status-dot[data-state="claimed"], .status-dot[data-state="queued"] { background-color: var(--status-pending); box-shadow: 0 0 0 3px rgb(245 166 35 / 20%); animation: status-pulse 1.6s ease-in-out infinite; }
  .status-dot[data-state="failed"] { background-color: var(--status-error); box-shadow: 0 0 0 3px rgb(229 72 77 / 20%); }
  .status-dot[data-state="pending"], .status-dot[data-state="canceled"] { background-color: var(--subtle); }
  @keyframes status-pulse { 50% { opacity: .45; } }
  .chip { display: inline-flex; height: 24px; align-items: center; gap: 6px; border-radius: 9999px; border: 1px solid var(--line); background: var(--surface); padding: 0 10px; font: 12px var(--font-mono); color: var(--muted); white-space: nowrap; }
  .chip .icon { width: 14px; height: 14px; }

  /* ---- tables ---- */
  .table-wrap { min-width: 0; overflow-x: auto; }
  .data-table { width: 100%; min-width: 560px; border-collapse: collapse; text-align: left; font-size: 14px; }
  .data-table th { border-bottom: 1px solid var(--line); background: var(--canvas); padding: 10px 16px; font-size: 12px; font-weight: 500; color: var(--muted); white-space: nowrap; }
  .data-table td { border-bottom: 1px solid var(--line); padding: 14px 16px; vertical-align: middle; }
  .data-table th:first-child, .data-table td:first-child { padding-left: 20px; }
  .data-table th:last-child, .data-table td:last-child { padding-right: 20px; }
  .data-table tr:last-child td { border-bottom: 0; }
  .data-table tbody tr { transition: background-color .15s; }
  .data-table tbody tr:hover { background: var(--canvas); }
  .data-table .num { text-align: right; font-variant-numeric: tabular-nums; }
  .data-table a.row-link { font-weight: 500; }
  .data-table a.row-link:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--line-strong); }

  /* ---- stat strip (hairline cells inside one border) ---- */
  .stat-strip { display: grid; overflow: hidden; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); margin: 0; }
  .stat-strip > div { padding: 20px; }
  .stat-strip > div + div { border-top: 1px solid var(--line); }
  .stat-strip dt { display: flex; align-items: center; justify-content: space-between; font-size: 13px; color: var(--muted); }
  .stat-strip dt .icon { width: 16px; height: 16px; }
  .stat-strip dd { margin: 12px 0 0; font-size: 28px; line-height: 1.5; font-weight: 600; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .stat-strip small { display: block; margin-top: 4px; font-size: 12px; color: var(--muted); }
  @media (min-width: 640px) {
    .stat-strip { grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); }
    .stat-strip > div { padding: 24px; }
    .stat-strip > div + div { border-top: 0; border-left: 1px solid var(--line); }
  }

  /* ---- forms ---- */
  .form-row + .form-row { margin-top: 16px; }
  .field-label { display: block; margin-bottom: 8px; font-size: 13px; font-weight: 500; color: var(--muted); }
  .field { width: 100%; border-radius: 6px; border: 1px solid var(--line); background: var(--surface); padding: 10px 12px; font: 14px/20px var(--font-sans); color: var(--ink); outline: none; transition: border-color .15s, box-shadow .15s; }
  .field::placeholder { color: var(--subtle); }
  .field:hover { border-color: var(--line-strong); }
  .field:focus { border-color: var(--muted); box-shadow: var(--shadow-focus); }
  .field:disabled { opacity: .6; cursor: not-allowed; }
  .field-hint { margin-top: 6px; font-size: 12px; line-height: 20px; color: var(--muted); }
  .form-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 24px; }

  /* ---- feedback ---- */
  .flash-success { margin-bottom: 24px; border-radius: 8px; border: 1px solid var(--line); background: var(--surface); padding: 12px 16px; font-size: 14px; }
  .flash-error { margin-bottom: 24px; border-radius: 8px; border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent); background: color-mix(in srgb, var(--danger) 5%, var(--surface)); padding: 12px 16px; font-size: 14px; color: var(--danger); }
  .empty-state { border-radius: 12px; border: 1px dashed var(--line-strong); padding: 56px 24px; text-align: center; }
  .empty-state h3 { font-size: 16px; line-height: 24px; font-weight: 600; letter-spacing: -.015em; }
  .empty-state p { margin: 4px auto 0; max-width: 28rem; font-size: 14px; line-height: 24px; color: var(--muted); }
  .empty-state .button-secondary { margin-top: 20px; }

  /* ---- code / log block (monochrome, like Kilat's docs code blocks) ---- */
  .code-block { margin: 0; overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); padding: 13px 16px; font: 13px/24px var(--font-mono); color: var(--ink); }
  .code-block .c { color: var(--muted); }
  .code-block .k { color: var(--ink); font-weight: 500; }
  .code-block .s { color: var(--muted); }
  .code-block .p { color: var(--subtle); user-select: none; }

  /* ---- user menu & appearance ---- */
  .user-menu { position: relative; }
  .user-menu > summary { list-style: none; }
  .user-menu > summary::-webkit-details-marker { display: none; }
  .user-menu-panel { position: absolute; z-index: 50; width: 256px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); padding: 8px; font-size: 14px; box-shadow: var(--shadow-menu); animation: menu-in .16s var(--ease-out); }
  .user-menu-head { border-bottom: 1px solid var(--line); padding: 8px 12px 12px; }
  .user-menu-head strong { display: block; font-weight: 500; }
  .user-menu-head span { display: block; margin-top: 2px; font-size: 12px; color: var(--muted); }
  .user-menu-panel .menu-list { padding: 6px 0; }
  .user-menu-panel a, .user-menu-panel button.menu-item { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 12px; border: 0; border-radius: 6px; background: none; padding: 8px 12px; text-align: left; font: 14px/20px var(--font-sans); color: var(--muted); transition: background-color .15s, color .15s; }
  .user-menu-panel a:hover, .user-menu-panel button.menu-item:hover { background: var(--accent-soft); color: var(--ink); }
  .user-menu-panel a .icon, .user-menu-panel button.menu-item .icon { width: 16px; height: 16px; }
  .user-menu-panel hr { margin: 6px 0; border: 0; border-top: 1px solid var(--line); }
  .user-menu-theme { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 12px; color: var(--muted); }
  .appearance-options { display: inline-grid; grid-template-columns: repeat(3, 1fr); gap: 2px; border-radius: 9999px; border: 1px solid var(--line); background: var(--canvas); padding: 2px; }
  .appearance-options button { display: flex; width: 28px; height: 28px; align-items: center; justify-content: center; border: 0; border-radius: 9999px; background: none; padding: 0; color: var(--muted); transition: color .15s; }
  .appearance-options button:hover { color: var(--ink); }
  .appearance-options button.is-active { background: var(--surface); color: var(--ink); box-shadow: 0 0 0 1px var(--line), 0 1px 2px rgb(0 0 0 / 6%); }
  .appearance-options .icon { width: 16px; height: 16px; }
  .user-avatar { display: flex; width: 32px; height: 32px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 9999px; border: 1px solid var(--line); background: linear-gradient(135deg, var(--ink) 30%, var(--subtle)); font-size: 12px; font-weight: 600; color: var(--canvas); text-transform: uppercase; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-4px) scale(.98); } }
</style>

<%# Shared design system for every layout: tokens, base styles and components. %>
<style>
  :root {
    color-scheme: dark;
    --bg: #0b0e14;
    --bg-raised: #11151d;
    --panel: #151a23;
    --panel-2: #0a0d12;
    --border: #262d3a;
    --border-strong: #364053;
    --text: #e8edf5;
    --text-2: #b4bdcc;
    --muted: #8590a2;
    --link: #6ea8ff;
    --accent: #ff7a1a;
    --accent-2: #ffb347;
    --accent-ink: #1a0d00;
    --green: #3fb950; --green-bg: rgba(63, 185, 80, .14);
    --red: #f85149;   --red-bg: rgba(248, 81, 73, .14);
    --amber: #e3b341; --amber-bg: rgba(227, 179, 65, .14);
    --blue: #58a6ff;  --blue-bg: rgba(88, 166, 255, .14);
    --violet: #bc8cff; --violet-bg: rgba(188, 140, 255, .14);
    --gray: #8590a2;  --gray-bg: rgba(133, 144, 162, .14);
    --radius: 10px;
    --radius-sm: 6px;
    --shadow: 0 1px 0 rgba(255, 255, 255, .03) inset, 0 8px 24px rgba(0, 0, 0, .25);
    --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Helvetica, Arial, sans-serif;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) {
      color-scheme: light;
      --bg: #f6f7f9; --bg-raised: #ffffff; --panel: #ffffff; --panel-2: #0d1117;
      --border: #e1e4ea; --border-strong: #cdd2db;
      --text: #141821; --text-2: #3d4554; --muted: #697386; --link: #0b62d6;
      --accent: #e8650a; --accent-2: #f59e0b; --accent-ink: #ffffff;
      --green: #1a7f37; --green-bg: #dafbe1;
      --red: #cf222e;   --red-bg: #ffebe9;
      --amber: #9a6700; --amber-bg: #fff8c5;
      --blue: #0969da;  --blue-bg: #ddf4ff;
      --violet: #8250df; --violet-bg: #fbefff;
      --gray: #6e7781;  --gray-bg: #eff1f4;
      --shadow: 0 1px 2px rgba(16, 24, 40, .06), 0 4px 12px rgba(16, 24, 40, .05);
    }
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.55 var(--sans); -webkit-font-smoothing: antialiased;
  }
  a { color: var(--link); text-decoration: none; }
  a:hover { text-decoration: underline; }
  code, kbd, .mono { font-family: var(--mono); font-size: .9em; }
  code { background: var(--gray-bg); border-radius: 4px; padding: .1em .4em; }
  pre code { background: none; padding: 0; font-size: inherit; }
  h1, h2, h3 { line-height: 1.25; letter-spacing: -.01em; margin: 0; }
  h1 { font-size: 26px; font-weight: 700; }
  h2 { font-size: 18px; font-weight: 650; }
  h3 { font-size: 15px; font-weight: 650; }
  p { margin: 0 0 12px; }
  :focus-visible { outline: 2px solid var(--link); outline-offset: 2px; border-radius: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .muted { color: var(--muted); }
  .nowrap { white-space: nowrap; }
  .truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .icon { width: 16px; height: 16px; flex: none; vertical-align: -3px; }
  .icon-lg { width: 20px; height: 20px; }

  /* ---- brand ---- */
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--text); font-weight: 750; font-size: 17px; letter-spacing: -.02em; }
  .brand:hover { text-decoration: none; }
  .brand .logo { width: 28px; height: 28px; }
  .brand .tag { font-size: 11px; font-weight: 600; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 1px 8px; letter-spacing: 0; }

  .avatar { width: 26px; height: 26px; border-radius: 50%; display: inline-grid; place-items: center; flex: none; font-size: 12px; font-weight: 700; color: var(--accent-ink); background: linear-gradient(135deg, var(--accent-2), var(--accent)); text-transform: uppercase; }

  /* ---- buttons ---- */
  .btn, button, input[type=submit] {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    font: 600 14px/1 var(--sans); padding: 9px 14px; border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong); background: var(--panel); color: var(--text);
    cursor: pointer; text-decoration: none; transition: background .12s, border-color .12s, transform .05s;
  }
  .btn:hover, button:hover { background: var(--gray-bg); text-decoration: none; }
  .btn:active, button:active { transform: translateY(1px); }
  .btn-primary, button.btn-primary {
    background: linear-gradient(180deg, var(--accent-2), var(--accent)); border-color: transparent; color: var(--accent-ink);
  }
  .btn-primary:hover, button.btn-primary:hover { filter: brightness(1.06); background: linear-gradient(180deg, var(--accent-2), var(--accent)); }
  .btn-danger, button.btn-danger { color: var(--red); border-color: color-mix(in srgb, var(--red) 40%, transparent); background: transparent; }
  .btn-danger:hover, button.btn-danger:hover { background: var(--red-bg); }
  .btn-ghost, button.btn-ghost { background: transparent; border-color: transparent; color: var(--text-2); }
  .btn-sm { padding: 6px 10px; font-size: 13px; }
  .btn-lg { padding: 12px 20px; font-size: 15px; }
  .btn-link, button.btn-link { background: none; border: 0; padding: 0; color: var(--link); font-weight: 500; }
  .btn-link:hover, button.btn-link:hover { background: none; text-decoration: underline; }
  form.button_to, form.inline { display: inline; margin: 0; }

  /* ---- forms ---- */
  .field { margin-bottom: 16px; }
  .field label, label.label { display: block; font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 6px; }
  .field .hint { font-size: 12.5px; color: var(--muted); margin-top: 6px; }
  input[type=text], input[type=password], input[type=email], select, textarea {
    width: 100%; background: var(--bg); color: var(--text); border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm); padding: 9px 11px; font: 14px var(--sans);
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--link); box-shadow: 0 0 0 3px var(--blue-bg); }
  .form-actions { display: flex; gap: 10px; align-items: center; margin-top: 20px; }

  /* ---- cards ---- */
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--border); }
  .card-body { padding: 18px; }
  .card-body.flush { padding: 0; }

  /* ---- badges ---- */
  .badge {
    display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px 3px 8px; border-radius: 999px;
    font-size: 12px; font-weight: 650; line-height: 1.4; white-space: nowrap;
  }
  .badge::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .st-success  { color: var(--green);  background: var(--green-bg); }
  .st-failed   { color: var(--red);    background: var(--red-bg); }
  .st-running  { color: var(--amber);  background: var(--amber-bg); }
  .st-running::before { animation: pulse 1.2s ease-in-out infinite; }
  .st-claimed  { color: var(--violet); background: var(--violet-bg); }
  .st-queued   { color: var(--blue);   background: var(--blue-bg); }
  .st-pending, .st-canceled, .st-skipped { color: var(--gray); background: var(--gray-bg); }
  .pill { display: inline-flex; align-items: center; gap: 6px; font: 12.5px var(--mono); color: var(--text-2); background: var(--gray-bg); border-radius: 999px; padding: 2px 9px; white-space: nowrap; }
  @keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
  @media (prefers-reduced-motion: reduce) { .st-running::before { animation: none; } }

  /* ---- tables ---- */
  .table-wrap { overflow-x: auto; }
  table.table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .table th { text-align: left; font-size: 12px; font-weight: 650; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; padding: 10px 16px; border-bottom: 1px solid var(--border); background: var(--bg-raised); white-space: nowrap; }
  .table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .table tr:last-child td { border-bottom: 0; }
  .table tbody tr:hover td { background: color-mix(in srgb, var(--gray-bg) 60%, transparent); }
  .table td.num, .table th.num { text-align: right; }
  .row-link { color: var(--text); font-weight: 600; }

  /* ---- flash ---- */
  .flash { display: flex; gap: 10px; align-items: flex-start; border-radius: var(--radius-sm); padding: 11px 14px; font-size: 14px; margin-bottom: 18px; border: 1px solid transparent; }
  .flash-notice { color: var(--green); background: var(--green-bg); border-color: color-mix(in srgb, var(--green) 30%, transparent); }
  .flash-alert { color: var(--red); background: var(--red-bg); border-color: color-mix(in srgb, var(--red) 30%, transparent); }

  /* ---- empty state ---- */
  .empty { text-align: center; padding: 40px 24px; color: var(--muted); }
  .empty .icon { width: 32px; height: 32px; color: var(--border-strong); margin-bottom: 10px; }
  .empty h3 { color: var(--text); margin-bottom: 6px; }
  .empty p { max-width: 460px; margin: 0 auto 4px; }

  /* ---- terminal / code ---- */
  .terminal { background: var(--panel-2); border: 1px solid #1e2430; border-radius: var(--radius); overflow: hidden; color: #d6deeb; }
  .terminal-bar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid #1e2430; background: #0f131a; font: 12.5px var(--mono); color: #8590a2; }
  .terminal-bar .dots { display: inline-flex; gap: 6px; margin-right: 6px; }
  .terminal-bar .dots i { width: 11px; height: 11px; border-radius: 50%; background: #2b3240; }
  .terminal-bar .dots i:nth-child(1) { background: #ff5f57; } .terminal-bar .dots i:nth-child(2) { background: #febc2e; } .terminal-bar .dots i:nth-child(3) { background: #28c840; }
  .terminal pre:empty::before { content: attr(data-empty); color: #6b7689; }
  .terminal pre { margin: 0; padding: 16px 18px; overflow-x: auto; font: 13px/1.65 var(--mono); }
  .terminal .c { color: #6b7689; } .terminal .k { color: #7fb4ff; } .terminal .s { color: #a5e3a1; } .terminal .p { color: #ffb347; user-select: none; }
</style>

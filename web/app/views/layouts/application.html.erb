<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ForgeCI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= yield :head %>
    <style>
      body { font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; margin: 0; background: #0d1117; color: #e6edf3; }
      header { background: #161b22; border-bottom: 1px solid #30363d; padding: 12px 24px; }
      header a { color: #e6edf3; text-decoration: none; font-weight: 700; font-size: 18px; }
      header a:hover { text-decoration: underline; }
      header a.home-link { font-weight: 400; font-size: 14px; color: #8b949e; float: right; margin-top: 3px; }
      header a.home-link:hover { color: #e6edf3; }
      main { padding: 24px; max-width: 1100px; margin: 0 auto; }
      h1, h2 { font-weight: 600; }
      h2 { margin-top: 32px; border-bottom: 1px solid #30363d; padding-bottom: 8px; }
      a { color: #58a6ff; }
      table { border-collapse: collapse; width: 100%; margin: 12px 0; }
      th, td { text-align: left; padding: 8px 12px; border-bottom: 1px solid #30363d; font-size: 14px; }
      th { color: #8b949e; font-weight: 600; text-transform: uppercase; font-size: 12px; }
      .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
      .st-pending  { background: #30363d; color: #e6edf3; }
      .st-queued   { background: #1f3a5f; color: #79c0ff; }
      .st-claimed  { background: #3b2f6b; color: #d2a8ff; }
      .st-running  { background: #5f4a1f; color: #ffdf5d; }
      .st-success  { background: #1f5f3a; color: #7ee787; }
      .st-failed   { background: #5f1f1f; color: #ff7b72; }
      .st-canceled { background: #3d3d3d; color: #b0b0b0; }
      .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
      .meta { color: #8b949e; font-size: 14px; }
      pre.logs { background: #010409; border: 1px solid #30363d; border-radius: 6px; padding: 16px; overflow-x: auto; font-size: 13px; line-height: 1.5; white-space: pre-wrap; }
      .requires { color: #8b949e; }
      .flash-alert { background: #5f1f1f; color: #ff7b72; border-radius: 6px; padding: 10px 14px; font-size: 14px; }
      .flash-notice { background: #1f5f3a; color: #7ee787; border-radius: 6px; padding: 10px 14px; font-size: 14px; }
      .stack { max-width: 380px; }
      .stack label { display: block; font-size: 13px; color: #8b949e; margin: 14px 0 6px; }
      input[type=text], input[type=password], select { width: 100%; box-sizing: border-box; background: #0d1117; border: 1px solid #30363d; border-radius: 6px; color: #e6edf3; padding: 8px 10px; font-size: 14px; }
      button, input[type=submit] { background: #238636; color: #fff; border: 0; border-radius: 6px; padding: 8px 14px; font-size: 14px; font-weight: 600; cursor: pointer; }
      .stack button { margin-top: 18px; }
      .inline-form { display: inline; margin-left: 8px; }
      button.inline-btn, .userbar button { background: transparent; color: #58a6ff; padding: 0; font-weight: 400; }
      .userbar { float: right; margin-top: 3px; font-size: 14px; color: #8b949e; }
      .userbar form { display: inline; }
      .userbar a { font-weight: 400; font-size: 14px; color: #58a6ff; margin-left: 12px; }
      .note { background: #161b22; border: 1px solid #30363d; border-radius: 6px; padding: 12px 16px; font-size: 14px; color: #8b949e; }
    </style>
  </head>
  <body>
    <header><a href="/projects">&#9881; ForgeCI</a> <span class="meta">control plane</span><span class="userbar"><% if signed_in? %><%= current_user.username %>
      <%= link_to "Account", account_path %><% if current_user.admin? %><%= link_to "Users", users_path %><% end %>
      <%= button_to "Sign out", logout_path, method: :delete, form: { class: "inline-form" }, class: "inline-btn" %><% end %></span></header>
    <main><%= yield %></main>
  </body>
</html>

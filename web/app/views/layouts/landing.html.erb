<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "ForgeCI — CircleCI-compatible CI/CD you run yourself" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="ForgeCI is open-source, MIT-licensed CI/CD that runs CircleCI 2.1 configs on your own infrastructure: Docker runners, live logs, caching, parallel test splitting and GitHub integration.">
    <meta property="og:title" content="ForgeCI — CircleCI-compatible CI/CD you run yourself">
    <meta property="og:description" content="Run your .circleci/config.yml on your own runners. Open source, MIT licensed.">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= csrf_meta_tags %>
    <%= render "layouts/design" %>
    <style>
      /* Landing pages: 1440px container, Fibonacci spacing (3 5 8 13 21 34 55 89 144) and the phi type scale. */
      html { scroll-behavior: smooth; }
      .lp-wrap { margin: 0 auto; max-width: 1440px; padding: 0 21px; }
      .lp-mono { font: 11px/1.5 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
      .lp-nav { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--canvas) 78%, transparent); backdrop-filter: saturate(180%) blur(16px); -webkit-backdrop-filter: saturate(180%) blur(16px); }
      .lp-nav-inner { display: flex; height: 64px; align-items: center; justify-content: space-between; gap: 13px; }
      .lp-nav-links { display: none; align-items: center; gap: 5px; font-size: 14px; color: var(--muted); }
      .lp-nav-links a { border-radius: 9999px; padding: 5px 13px; transition: background-color .15s, color .15s; }
      .lp-nav-links a:hover { background: var(--accent-soft); color: var(--ink); }
      .lp-nav-actions { display: flex; align-items: center; gap: 8px; }
      .lp-nav-actions .button-primary, .lp-nav-actions .button-secondary { height: 32px; border-radius: 9999px; padding: 0 13px; font-size: 13px; }
      .lp-btn { display: inline-flex; height: 48px; align-items: center; gap: 13px; border-radius: 9999px; padding: 0 8px 0 21px; font-size: 14px; font-weight: 500; background: var(--ink); color: var(--canvas); transition: transform .5s var(--ease-out); }
      .lp-btn-icon { display: flex; width: 32px; height: 32px; align-items: center; justify-content: center; border-radius: 9999px; background: var(--canvas); color: var(--ink); transition: transform .5s var(--ease-out); }
      .lp-btn-icon .icon { width: 16px; height: 16px; }
      .lp-btn:hover .lp-btn-icon { transform: translateX(3px); }
      .lp-btn-ghost { display: inline-flex; height: 48px; align-items: center; gap: 8px; border-radius: 9999px; border: 1px solid var(--line); padding: 0 21px; font-size: 14px; font-weight: 500; transition: border-color .15s, background-color .15s; }
      .lp-btn-ghost:hover { border-color: var(--line-strong); background: var(--surface); }
      .lp-btn-ghost .icon { width: 16px; height: 16px; }
      .lp-hero { position: relative; isolation: isolate; padding-top: clamp(34px, 7vw, 89px); }
      .lp-hero-grid { position: absolute; inset: -64px 0 0; z-index: -1; pointer-events: none;
        background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: 72px 72px; background-position: center top;
        mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%); }
      .lp-hero-layout { display: grid; gap: 34px; align-items: center; }
      .lp-hero-layout > * { min-width: 0; }
      .lp-tag { display: inline-flex; align-items: center; gap: 8px; border-radius: 9999px; border: 1px solid var(--line); background: var(--surface); padding: 5px 13px 5px 5px; font-size: 12px; color: var(--muted); }
      .lp-tag b { border-radius: 9999px; padding: 2px 8px; font: 500 10px var(--font-mono); text-transform: uppercase; letter-spacing: .05em; background: var(--ink); color: var(--canvas); }
      .lp-display { margin-top: 34px; font-size: clamp(52px, 9.2vw, 109.67px); font-weight: 600; line-height: .9; letter-spacing: -.065em; text-wrap: balance; }
      .lp-display .dim { color: var(--subtle); }
      .lp-lede { margin-top: 34px; max-width: 34rem; font-size: 16px; line-height: 28px; color: var(--muted); }
      .lp-lede strong { font-weight: 500; color: var(--ink); }
      .lp-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 13px; margin-top: 34px; }
      .lp-stage { border-radius: 28px; border: 1px solid var(--line); background: var(--surface); padding: 13px; }
      .lp-stage-head { display: flex; align-items: center; justify-content: space-between; padding: 8px 8px 13px; }
      .lp-stage .code-block { border-radius: 16px; background: var(--canvas); font-size: 12.5px; line-height: 22px; }
      .lp-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 55px 0 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
      .lp-facts > div { padding: 21px 13px 21px 0; }
      .lp-facts > div:nth-child(2n) { border-left: 1px solid var(--line); padding-left: 13px; }
      .lp-facts > div:nth-child(n+3) { border-top: 1px solid var(--line); }
      .lp-facts dt { font: 10px/1.5 var(--font-mono); text-transform: uppercase; letter-spacing: .12em; color: var(--muted); }
      .lp-facts dd { margin: 8px 0 0; font-size: 25.89px; line-height: 1.1; font-weight: 600; letter-spacing: -.04em; }
      .lp-section { padding-block: clamp(89px, 12vw, 144px); scroll-margin-top: 64px; }
      .lp-section + .lp-section { border-top: 1px solid var(--line); }
      .lp-head { display: grid; gap: 21px; margin-bottom: 55px; }
      .lp-head h2 { font-size: clamp(41.89px, 5.6vw, 67.78px); font-weight: 600; line-height: .98; letter-spacing: -.055em; text-wrap: balance; }
      .lp-head h2 .dim { color: var(--subtle); }
      .lp-head > p:last-child { max-width: 24rem; font-size: 16px; line-height: 28px; color: var(--muted); }
      .lp-bento { display: grid; gap: 13px; }
      .lp-card { position: relative; display: flex; min-height: 240px; flex-direction: column; overflow: hidden; border-radius: 24px; border: 1px solid var(--line); background: var(--surface); padding: 34px; transition: border-color .4s; }
      .lp-card:hover { border-color: var(--line-strong); }
      .lp-card-label { font: 10px/1.5 var(--font-mono); text-transform: uppercase; letter-spacing: .14em; color: var(--muted); }
      .lp-card h3 { margin-top: auto; padding-top: 34px; font-size: 20.35px; line-height: 1.2; font-weight: 600; letter-spacing: -.03em; }
      .lp-card p { margin-top: 13px; max-width: 28rem; font-size: 14px; line-height: 24px; color: var(--muted); }
      .lp-card code { border-radius: 4px; background: var(--accent-soft); padding: 1px 5px; font-size: 12.5px; color: var(--ink); }
      .lp-steps { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
      .lp-steps li { display: grid; gap: 8px 34px; padding: 34px 0; border-bottom: 1px solid var(--line); }
      .lp-steps .lp-mono { color: var(--muted); }
      .lp-steps h3 { font-size: 25.89px; line-height: 1.1; font-weight: 600; letter-spacing: -.045em; }
      .lp-steps p { max-width: 36rem; font-size: 16px; line-height: 28px; color: var(--muted); }
      .lp-steps code, .lp-head code { font-size: .9em; }
      .compat { display: grid; gap: 13px; }
      .compat ul { margin: 0; padding: 0; list-style: none; }
      .compat li { display: flex; align-items: flex-start; gap: 10px; padding: 12px 0; border-top: 1px solid var(--line); font-size: 14px; line-height: 24px; color: var(--muted); }
      .compat li .icon { width: 16px; height: 16px; margin-top: 4px; flex-shrink: 0; }
      .compat .yes .icon { color: var(--ok); }
      .compat .no .icon { color: var(--subtle); }
      .compat code, .lp-section .note code { border-radius: 4px; background: var(--accent-soft); padding: 1px 5px; font-size: 12.5px; color: var(--ink); }
      .lp-section .note { margin-top: 21px; max-width: 44rem; font-size: 14px; line-height: 24px; color: var(--muted); }
      .lp-cta { position: relative; isolation: isolate; overflow: hidden; margin-top: 21px; padding: clamp(89px, 11vw, 144px) 21px; border-radius: 32px; background: var(--ink); color: var(--canvas); text-align: center; }
      .lp-cta-grid { position: absolute; inset: 0; z-index: -1; opacity: .12; background-image: radial-gradient(currentColor 1px, transparent 1px); background-size: 22px 22px; mask-image: radial-gradient(ellipse at center, #000, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at center, #000, transparent 70%); }
      .lp-cta-mark { position: absolute; z-index: -1; right: -4%; bottom: -18%; width: min(420px, 60%); opacity: .08; color: var(--canvas); }
      .lp-cta .lp-mono { color: color-mix(in srgb, var(--canvas) 60%, transparent); }
      .lp-cta h2 { margin-top: 34px; font-size: clamp(41.89px, 8.5vw, 109.67px); font-weight: 600; line-height: .9; letter-spacing: -.065em; text-wrap: balance; }
      .lp-cta p:not(.lp-mono) { margin: 34px auto 0; max-width: 28rem; font-size: 16px; line-height: 28px; color: color-mix(in srgb, var(--canvas) 65%, transparent); }
      .lp-cta .lp-btn { margin-top: 34px; background: var(--canvas); color: var(--ink); }
      .lp-cta .lp-btn-icon { background: var(--ink); color: var(--canvas); }
      .lp-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 21px; padding: 55px 0; font-size: 13px; color: var(--muted); }
      .lp-footer nav { display: flex; flex-wrap: wrap; gap: 21px; }
      .lp-footer a:hover { color: var(--ink); }
      @media (min-width: 640px) {
        .lp-wrap { padding: 0 34px; }
        .lp-lede { font-size: 20.35px; line-height: 32px; }
        .lp-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .compat { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px; }
        .lp-steps li { grid-template-columns: 80px minmax(0, 1fr) minmax(0, 1.4fr); align-items: baseline; }
      }
      @media (min-width: 768px) { .lp-nav-links { display: flex; } }
      @media (min-width: 1024px) {
        .lp-wrap { padding: 0 55px; }
        .lp-hero-layout { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px; }
        .lp-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 89px; }
        .lp-facts > div:nth-child(n+2) { border-left: 1px solid var(--line); padding-left: 13px; }
        .lp-facts > div:nth-child(n+3) { border-top: 0; }
        .lp-facts dd { font-size: 32.94px; }
        .lp-head { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: end; margin-bottom: 89px; }
        .lp-head .lp-mono { grid-column: span 12; }
        .lp-head h2 { grid-column: span 8; }
        .lp-head > p:last-child { grid-column: span 4; justify-self: end; }
        .lp-bento { grid-template-columns: repeat(6, minmax(0, 1fr)); }
        .lp-bento > .lp-card { grid-column: span 2; }
        .lp-bento > .lp-card:nth-child(-n+2) { grid-column: span 3; min-height: 360px; }
        .lp-bento > .lp-card:nth-child(-n+2) h3 { font-size: 25.89px; letter-spacing: -.045em; }
      }
    </style>
  </head>
  <body>
    <header class="lp-nav">
      <div class="lp-wrap lp-nav-inner">
        <%= render "shared/brand" %>
        <nav class="lp-nav-links" aria-label="Main">
          <a href="#features">Features</a>
          <a href="#how-it-works">How it works</a>
          <a href="#compatibility">Compatibility</a>
          <a href="#quickstart">Quickstart</a>
        </nav>
        <div class="lp-nav-actions">
          <a class="button-secondary" href="https://github.com/azmi2409/forge-ci"><%= icon "github" %>GitHub</a>
          <a class="button-primary" href="/projects">Sign in</a>
        </div>
      </div>
    </header>
    <main id="main-content"><%= yield %></main>
    <footer class="lp-wrap">
      <div class="lp-footer">
        <span>ForgeCI is open source under the MIT License.</span>
        <nav aria-label="Footer">
          <a href="https://github.com/azmi2409/forge-ci">GitHub</a>
          <a href="https://github.com/azmi2409/forge-ci/blob/main/DEPLOY.md">Deploy guide</a>
          <a href="https://github.com/azmi2409/forge-ci/blob/main/CONTRIBUTING.md">Contributing</a>
          <a href="https://github.com/azmi2409/forge-ci/blob/main/MIT-LICENSE">License</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

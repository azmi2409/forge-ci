<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "ForgeCI — CircleCI-compatible CI/CD you run yourself" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="ForgeCI is open-source, MIT-licensed CI/CD that runs CircleCI 2.1 configs on your own infrastructure: Docker runners, live logs, caching, parallel test splitting and GitHub integration.">
    <meta property="og:title" content="ForgeCI — CircleCI-compatible CI/CD you run yourself">
    <meta property="og:description" content="Run your .circleci/config.yml on your own runners. Open source, MIT licensed.">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= csrf_meta_tags %>
    <%= render "layouts/design" %>
    <style>
      html { scroll-behavior: smooth; }
      .wrap { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
      .lnav { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--border); }
      .lnav .wrap { height: 62px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
      .lnav nav { display: flex; align-items: center; gap: 6px; }
      .lnav nav a.l { color: var(--text-2); font-weight: 550; font-size: 14.5px; padding: 7px 12px; border-radius: var(--radius-sm); }
      .lnav nav a.l:hover { color: var(--text); background: var(--gray-bg); text-decoration: none; }
      section.block { padding: 88px 0; }
      section.block + section.block { border-top: 1px solid var(--border); }
      .hero { padding: 96px 0 84px; position: relative; overflow: hidden; }
      .hero::before { content: ""; position: absolute; inset: -40% -10% auto; height: 620px; background: radial-gradient(600px 300px at 30% 30%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 70%), radial-gradient(500px 260px at 80% 20%, color-mix(in srgb, var(--blue) 14%, transparent), transparent 70%); pointer-events: none; }
      .hero .wrap { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: center; }
      .hero .wrap > * { min-width: 0; }
      .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--text-2); border: 1px solid var(--border); background: var(--panel); border-radius: 999px; padding: 5px 14px; margin-bottom: 22px; }
      .eyebrow b { color: var(--accent); }
      .hero h1 { font-size: clamp(2.5rem, 5.6vw, 4rem); line-height: 1.05; letter-spacing: -.035em; font-weight: 800; margin-bottom: 22px; }
      .hero h1 .grad { background: linear-gradient(90deg, var(--accent-2), var(--accent)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .hero .lead { font-size: 19px; color: var(--text-2); max-width: 600px; margin-bottom: 32px; }
      .cta { display: flex; gap: 12px; flex-wrap: wrap; }
      .proof { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 34px; color: var(--muted); font-size: 14px; }
      .proof span { display: inline-flex; align-items: center; gap: 7px; }
      .proof .icon { color: var(--green); }
      .kicker { font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
      .h2 { font-size: clamp(1.8rem, 3.4vw, 2.4rem); letter-spacing: -.025em; font-weight: 780; margin-bottom: 14px; }
      .sub { color: var(--text-2); font-size: 17.5px; max-width: 660px; margin-bottom: 44px; }
      .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 16px; }
      .feature { padding: 24px; }
      .feature .fi { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; margin-bottom: 16px; color: var(--accent); background: color-mix(in srgb, var(--accent) 13%, transparent); }
      .feature .fi .icon { width: 20px; height: 20px; }
      .feature h3 { font-size: 16.5px; margin-bottom: 8px; }
      .feature p { color: var(--text-2); font-size: 14.5px; margin: 0; }
      .steps3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; counter-reset: s; }
      .step { padding: 24px; position: relative; }
      .step::before { counter-increment: s; content: counter(s); display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; font-weight: 750; color: var(--accent-ink); background: linear-gradient(135deg, var(--accent-2), var(--accent)); margin-bottom: 14px; }
      .step h3 { font-size: 16.5px; margin-bottom: 8px; }
      .step p { color: var(--text-2); font-size: 14.5px; margin: 0; }
      .compat { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
      .compat ul { list-style: none; margin: 0; padding: 6px 0; }
      .compat li { display: flex; gap: 10px; align-items: flex-start; padding: 9px 20px; font-size: 14.5px; color: var(--text-2); }
      .compat li + li { border-top: 1px solid var(--border); }
      .compat li .icon { margin-top: 3px; }
      .compat .yes .icon { color: var(--green); } .compat .no .icon { color: var(--muted); }
      .arch pre { margin: 0; font: 13.5px/1.7 var(--mono); color: var(--text-2); overflow-x: auto; padding: 26px; }
      .arch .hl { color: var(--accent); font-weight: 700; }
      .note { color: var(--muted); font-size: 14.5px; margin-top: 18px; max-width: 720px; }
      .final { text-align: center; }
      .final .sub { margin: 0 auto 30px; }
      .final .cta { justify-content: center; }
      .lfoot { border-top: 1px solid var(--border); padding: 34px 0 44px; color: var(--muted); font-size: 14px; }
      .lfoot .wrap { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
      .lfoot nav { display: flex; gap: 18px; flex-wrap: wrap; }
      .lfoot a { color: var(--muted); } .lfoot a:hover { color: var(--text); }
      @media (max-width: 900px) { .hero .wrap { grid-template-columns: 1fr; gap: 40px; } .hero { padding: 64px 0 56px; } section.block { padding: 64px 0; } }
      @media (max-width: 640px) { .lnav nav a.l { display: none; } .cta .btn { flex: 1 1 auto; } }
    </style>
  </head>
  <body>
    <header class="lnav">
      <div class="wrap">
        <a class="brand" href="/"><%= render "shared/logo" %>ForgeCI</a>
        <nav aria-label="Main">
          <a class="l" href="#features">Features</a>
          <a class="l" href="#how-it-works">How it works</a>
          <a class="l" href="#compatibility">Compatibility</a>
          <a class="l" href="#quickstart">Quickstart</a>
          <a class="l" href="https://github.com/azmi2409/forge-ci"><%= icon "github" %> GitHub</a>
          <a class="btn btn-sm" href="/projects">Sign in</a>
        </nav>
      </div>
    </header>
    <main><%= yield %></main>
    <footer class="lfoot">
      <div class="wrap">
        <a class="brand" href="/"><%= render "shared/logo" %>ForgeCI</a>
        <nav aria-label="Footer">
          <a href="https://github.com/azmi2409/forge-ci">GitHub</a>
          <a href="https://github.com/azmi2409/forge-ci/blob/main/DEPLOY.md">Deploy guide</a>
          <a href="https://github.com/azmi2409/forge-ci/blob/main/CONTRIBUTING.md">Contributing</a>
          <a href="https://github.com/azmi2409/forge-ci/blob/main/MIT-LICENSE">MIT License</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Sign in — ForgeCI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= csrf_meta_tags %>
    <%= render "layouts/design" %>
    <style>
      body { min-height: 100vh; display: grid; place-items: center; padding: 24px;
             background: radial-gradient(900px 500px at 50% -10%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%), var(--bg); }
      .auth { width: 100%; max-width: 380px; }
      .auth .brand { justify-content: center; width: 100%; font-size: 20px; margin-bottom: 22px; }
      .auth .brand .logo { width: 34px; height: 34px; }
      .auth .card-body { padding: 26px; }
      .auth h1 { font-size: 20px; margin-bottom: 4px; }
      .auth .lead { color: var(--muted); font-size: 14px; margin-bottom: 22px; }
      .auth button[type=submit] { width: 100%; margin-top: 6px; padding: 11px; }
      .auth .hint { color: var(--muted); font-size: 13px; margin: 16px 0 0; }
      .auth .back { text-align: center; margin-top: 18px; font-size: 13.5px; }
      .auth .back a { color: var(--muted); }
    </style>
  </head>
  <body><%= yield %></body>
</html>

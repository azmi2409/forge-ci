<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Sign in — ForgeCI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= csrf_meta_tags %>
    <%= render "layouts/design" %>
    <style>
      body { min-height: 100vh; display: grid; place-items: center; padding: 24px 16px; }
      .auth-grid { position: fixed; inset: 0; z-index: -1; pointer-events: none;
        background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: 72px 72px; background-position: center top;
        mask-image: radial-gradient(ellipse 60% 50% at 50% 40%, #000 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 40%, #000 20%, transparent 75%); }
      .auth { width: 100%; max-width: 400px; }
      .auth > .brand { display: flex; justify-content: center; margin-bottom: 24px; }
      .auth h1 { font-size: 20px; line-height: 28px; font-weight: 600; letter-spacing: -.02em; }
      .auth .lead { margin: 4px 0 24px; font-size: 14px; color: var(--muted); }
      .auth .hint { margin-top: 16px; font-size: 13px; line-height: 20px; color: var(--muted); }
      .auth .back { margin-top: 20px; text-align: center; font-size: 13px; color: var(--muted); }
      .auth .back a:hover { color: var(--ink); }
    </style>
  </head>
  <body>
    <div class="auth-grid" aria-hidden="true"></div>
    <%= yield %>
  </body>
</html>

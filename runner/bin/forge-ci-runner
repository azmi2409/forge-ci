#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "forge_ci_runner"

begin
  config = ForgeCIRunner::Config.from_env
rescue ForgeCIRunner::Config::Error => e
  $stderr.puts "forge-ci-runner: #{e.message}"
  exit 2
end

unless ForgeCIRunner::Executor.docker_available?(config.docker_bin)
  $stderr.puts "forge-ci-runner: docker is not available " \
               "(`#{config.docker_bin} info` failed)"
  exit 2
end

ForgeCIRunner::Runner.new(config).run

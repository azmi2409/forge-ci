{
  "id": 1042,
  "name": "test (3/4)",
  "node_index": 2,
  "parallelism": 4,
  "working_directory": "~/app",
  "executor": {
    "image": "cimg/ruby:3.2",
    "environment": { "BUNDLE_PATH": "vendor/bundle" },
    "resource_class": "medium",
    "entrypoint": "/bin/sh",
    "command": "sleep infinity",
    "secondary_images": [
      { "image": "postgres:16", "environment": { "POSTGRES_PASSWORD": "ci" }, "name": "db" },
      { "image": "redis:7", "name": "cache" }
    ]
  },
  "steps": [
    { "type": "checkout" },
    { "type": "run", "name": "bundle install", "command": "bundle install", "no_output_timeout": "10m" },
    { "type": "restore_cache", "keys": ["gems-v1-{{ checksum \"Gemfile.lock\" }}", "gems-v1-"] },
    { "type": "save_cache", "key": "gems-v1-{{ checksum \"Gemfile.lock\" }}", "paths": ["vendor/bundle"] },
    { "type": "run", "name": "tests", "command": "bundle exec rake", "when": "always" },
    { "type": "store_artifacts", "path": "tmp/capybara", "destination": "screenshots" },
    { "type": "setup_remote_docker", "layer_caching": true },
    { "type": "run", "command": "forge-ci-build -t registry/app:sha .", "background": true },
    { "type": "persist_to_workspace", "root": ".", "paths": ["tmp"] }
  ],
  "environment": {
    "DATABASE_URL": "postgres://ci:secret-pw@db:5432/app_test",
    "FORGE_TOKEN": "s3cr3t-token-value-0001"
  },
  "secret_values": ["s3cr3t-token-value-0001"],

# Everything here is optional. `docker compose up -d` works without a .env:
# secrets are generated on first boot and kept in the forge-ci-data volume.
# See DEPLOY.md and docs/configuration.md.

# Public URL of the server (webhooks, commit-status links, runner installs).
APP_HOST=http://localhost:3000
# Set to true when a proxy in front serves HTTPS (Secure cookie, HSTS).
#FORCE_SSL=true
# Host port for the web UI.
#WEB_PORT=3000

# Postgres password for the bundled database.
#POSTGRES_PASSWORD=postgres

# --- Logs, artifacts and caches in S3 instead of the data volume ---
#ACTIVE_STORAGE_SERVICE=amazon
#AWS_S3_BUCKET=
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# --- Overrides for generated values ---
# The first admin (otherwise "admin" with a password printed in the logs).
#FORGE_CI_UI_USER=
#FORGE_CI_UI_PASSWORD=
#FORGE_CI_ADMIN_TOKEN=
#FORGE_CI_RUNNER_TOKEN=
#SECRET_KEY_BASE=
#ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
#ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
#ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- A GitHub App you registered yourself (instead of Settings → Connect GitHub) ---
#GITHUB_APP_ID=
#GITHUB_APP_PRIVATE_KEY=
#GITHUB_WEBHOOK_SECRET=

# --- Runners on this machine (they use its Docker socket) ---
# How many jobs to run here at once; 0 runs no runner on this machine.
#RUNNERS=1
# Only claim jobs with this resource_class (default: any).
#RUNNER_RESOURCE_CLASS=

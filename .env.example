# Copy to .env and adjust. The values below are DEV-ONLY defaults so that
# `docker compose up --build` works out of the box for local evaluation.
# REPLACE every secret before any real or public use.

# --- Postgres ---
POSTGRES_PASSWORD=postgres

# --- AWS S3 (job logs, artifacts, cache tarballs) ---
# Create the bucket first: aws s3 mb s3://<bucket> --region <region>
# The app does NOT create it for you.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Rails ---
# Dev-only. Generate a real one for anything serious: `openssl rand -hex 64`
SECRET_KEY_BASE=9c215b06605297a435a3c9bd94f0414ab83034ea1849298f2cf2a4409e012fc14ec925640f9eb26033f385d2112ef409ab2ffee362330ab489b20c11f8aa83ee

# Dev-only. Generate real ones: `docker compose run --rm web bin/rails db:encryption:init`
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=PIaKiID8mVAYOMqTmlmQK9hiNJlIXt45
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=SK0UaypOSbbQDwoE7E1H2X85FVxXQF9H
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=5vUJO98y1Ai188TtTOoA0UvXauDB2MJK

# --- Web UI basic auth ---
FORGE_CI_UI_USER=admin
FORGE_CI_UI_PASSWORD=password

# --- Misc ---
# Public base URL of the control plane (commit-status links, webhook target)
APP_HOST=http://localhost:3000
# Host port for the web UI (container serves :80 via Thruster)
WEB_PORT=3000

# --- Runner ---
# Shared runner secret (Drone-style). Pick any strong random value:
#   openssl rand -hex 32
# The SAME value is used as the server's FORGE_CI_RUNNER_TOKEN and the
# runner's RUNNER_TOKEN — the runner connects with no further setup.
# Leave empty to keep the runner stopped (it fails fast if unset).
RUNNER_TOKEN=
RUNNER_RESOURCE_CLASS=medium
